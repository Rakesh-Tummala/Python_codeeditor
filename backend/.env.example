GEMINI_API_KEY=

# Comma-separated list of origins allowed to call this API (CORS).
# Defaults to the Vite dev server if unset.
FRONTEND_ORIGINS=http://localhost:5173

# Auto-generated into .env on first run if left unset - only set this
# yourself if you're restoring a backend onto a new machine and want
# previously-stored GitHub tokens to keep decrypting correctly.
GITHUB_TOKEN_KEY=
