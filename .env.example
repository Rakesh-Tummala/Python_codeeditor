# Root-level config for `docker compose up` (not used by bare-metal dev -
# see backend/.env.example and frontend/.env.example for that instead).
# Copy to `.env` in this directory and fill in.

# Absolute HOST path where session data will live. Bind-mounted into the
# backend container at /app/sessions, and also handed to the backend
# directly (as HOST_SESSIONS_DIR) so it can tell the Docker daemon the
# right path when spawning sandbox containers - see
# backend/app/sessions_store.py's host_mount_path() for why.
PYTRACE_HOST_DATA_DIR=/absolute/path/to/pytrace/data/sessions

GEMINI_API_KEY=

FRONTEND_ORIGINS=http://localhost:5173

# Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Set explicitly here rather than relying on backend/app/github_integration.py's
# auto-generate-into-.env fallback - that only persists on a real
# filesystem across restarts, not inside a container that gets recreated.
GITHUB_TOKEN_KEY=

# Baked into the frontend's built JS bundle at image-build time (see
# frontend/Dockerfile) - rebuild the frontend image after changing these.
VITE_API_HTTP_BASE=http://localhost:8000
VITE_API_WS_BASE=ws://localhost:8000

# Google OAuth (sign-in) - see backend/.env.example for how to obtain these.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
FRONTEND_URL=http://localhost:5173

# Signs login session tokens. Left unset, the backend mints one on first
# run and persists it into backend/.env inside the container - fine for a
# single long-lived container, but that persistence is lost if the
# container is recreated (not just restarted), which invalidates existing
# logins. Set explicitly here to survive container recreation.
AUTH_SECRET_KEY=
